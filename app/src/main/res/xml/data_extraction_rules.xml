<?xml version="1.0" encoding="utf-8"?>
<!--
  Copia de seguridad de Android (Google la guarda en el Drive del usuario y la restaura al instalar
  la app en otro móvil) y transferencia directa entre móviles. Se incluye la base de datos completa
  (con sus archivos -wal/-shm) y las fotos; los ajustes no, porque el permiso sobre el archivo de la
  copia diaria no sirve en otro dispositivo.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="photos/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="photos/" />
    </device-transfer>
</data-extraction-rules>
